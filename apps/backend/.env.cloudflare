# Zoom Pro Backend - Cloudflare Tunnel Environment
# Kopíruj do: apps/backend/.env (když běží přes Cloudflare Tunnel)

NODE_ENV=production
PORT=5000

# ⚠️ Změň na svou doménu!
DATABASE_URL=postgresql://vzt_user:tvoje_hesla@127.0.0.1:5432/vzt_system

# ⚠️ Vygeneruj super silné heslo! (min 32 znaků)
JWT_SECRET=SuperSilneHesloZde123456789!@#$%^&*()_+-=[]{}|;:,.<>?

# Cloudflare domény
CORS_ORIGIN=https://app.tvoje-domena.cz,https://api.tvoje-domena.cz,capacitor://localhost,https://localhost

APP_NAME=zoom-pro
TRUST_PROXY=true

# Database pooling
PG_POOL_MAX=20
PG_IDLE_TIMEOUT_MS=30000

# Push notifikace (volitelné)
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
FCM_OAUTH_TOKEN=

# Gemini AI (volitelné)
GEMINI_API_KEY=
