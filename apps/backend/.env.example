NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://USER:CHANGE_ME@localhost:5432/DB_NAME?schema=public
JWT_SECRET=dev-super-secret
CORS_ORIGIN=http://localhost:5173
APP_NAME=zoom-pro
TRUST_PROXY=false
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000

# --- Push notifikace (volitelné; mobilní chat, podpora, registrace) ---
FCM_PROJECT_ID=
# Jednorádkový JSON service účtu; v produkci používejte chráněné tajemství.
FCM_SERVICE_ACCOUNT_JSON=
# Lokální alternativa: soubor service účtu.
FCM_SERVICE_ACCOUNT_FILE=
# Krátkodobé ladění, ne trvalá produkční konfigurace.
FCM_OAUTH_TOKEN=

# --- Push notifikace pro web/PWA ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@zoom-pro.app
