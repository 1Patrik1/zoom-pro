# Zoom Pro Frontend - Cloudflare Tunnel Environment
# Kopíruj do: apps/frontend/.env (když běží přes Cloudflare Tunnel)

# ⚠️ Změň na svou doménu!
VITE_API_URL=https://api.tvoje-domena.cz
VITE_CHAT_URL=https://api.tvoje-domena.cz
VITE_APP_NAME=Zoom Pro

# PWA config (pro mobilní app)
VITE_MOBILE_API_URL=https://api.tvoje-domena.cz
VITE_APP_ID=zoom-pro
VITE_VERSION=1.0.0
