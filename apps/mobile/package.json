    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "workbox-window": "^7.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
