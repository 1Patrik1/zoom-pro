# Zoom Pro — produkční .env pro VPS (docker-compose.prod.yml)
# Zkopíruj na VPS do /opt/zoom-pro/.env a vyplň skutečné hodnoty.
# Tento soubor jde do GitHubu (je to jen šablona); skutečný .env je v .gitignore.

# --- Postgres ---
POSTGRES_DB=vzt_system
POSTGRES_USER=vzt_user
POSTGRES_PASSWORD=change-me-strong-password

# --- Backend ---
JWT_SECRET=change-me-64-random-hex-chars
APP_NAME=zoom-pro
TRUST_PROXY=true
# Veřejné domény, ze kterých smí frontend volat API (oddělené čárkou):
CORS_ORIGIN=https://zoom-pro.app,https://www.zoom-pro.app,https://zoom-pro.pages.dev
HTTP_PORT=80
NODE_ENV=production
