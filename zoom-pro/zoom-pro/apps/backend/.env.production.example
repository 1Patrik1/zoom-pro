# Zoom Pro backend — produkční hodnoty (na VPS se přepisují z root .env přes compose)
NODE_ENV=production
PORT=5000
DATABASE_URL=postgresql://vzt_user:change-me-strong-password@postgres:5432/vzt_system
JWT_SECRET=change-me-64-random-hex-chars
CORS_ORIGIN=https://zoom-pro.app,https://www.zoom-pro.app,https://zoom-pro.pages.dev
APP_NAME=zoom-pro
TRUST_PROXY=true
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000

# --- Push notifikace (volitelné; bez nich endpoint /api/devices/notify vrací hint) ---
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
FCM_OAUTH_TOKEN=
