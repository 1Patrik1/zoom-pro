# Produkční konfigurace Zoom Pro — doplň skutečné hodnoty mimo Git.
POSTGRES_DB=vzt_system
POSTGRES_USER=vzt_user
POSTGRES_PASSWORD=CHANGE_ME_USE_A_UNIQUE_RANDOM_PASSWORD
JWT_SECRET=CHANGE_ME_USE_AT_LEAST_32_RANDOM_CHARACTERS
CORS_ORIGIN=https://your-cloudflare-pages-domain.example
HTTP_PORT=80
BACKEND_PORT=5000

# Pouze pro první seed / rotaci starého veřejného admin hesla.
# Min. 20 znaků; po úspěšném prvním vytvoření smaž z .env.
INITIAL_ADMIN_PASSWORD=

# --- Push notifikace přes FCM (volitelné) ---
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# --- Web Push (VAPID; soukromý klíč drž mimo repozitář) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@zoom-pro.app
