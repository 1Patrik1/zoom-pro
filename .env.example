# Zoom Pro — root .env (používá se pro Docker production compose a skripty)

# --- Postgres ---
POSTGRES_DB=vzt_system
POSTGRES_USER=vzt_user
POSTGRES_PASSWORD=change-me-in-production

DATABASE_URL=postgresql://USER:CHANGE_ME@localhost:5432/DB_NAME?schema=public

# --- Backend ---
JWT_SECRET=change-me-please
APP_NAME=zoom-pro
CORS_ORIGIN=http://localhost:5173,capacitor://localhost,https://localhost

# --- AI ---
GEMINI_API_KEY=

# --- Push notifikace (Firebase Cloud Messaging; citlivé údaje držte jako tajemství) ---
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@zoom-pro.app

# --- HTTP porty ---
HTTP_PORT=80
BACKEND_PORT=5000

# --- Aplikace ---
NODE_ENV=production
